local function ToggleSpell(lang)
  if vim.o.spell and vim.o.spelllang == lang then
    vim.o.spell = false
  else
    vim.o.spell = true
    vim.o.spelllang = lang
  end
end
map("n", "<leader>spe", function() ToggleSpell("en_us") end)
map("n", "<leader>spg", function() ToggleSpell("de_de") end)

