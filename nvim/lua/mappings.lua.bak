local function EditSnippets()
  local ft = vim.bo.filetype
  if ft == "" then return end
  vim.cmd("edit " .. vim.fn.expand("~/.config/nvim/snips/" .. ft .. ".lua"))
end
map("n", "<leader>sn", EditSnippets, { desc = "Edit Snippets for Current Filetype", silent = true })

-------------------------------
-- NATIVE REPL EVALUATION
-------------------------------
local function get_active_terminal()
  for _, buf in ipairs(vim.api.nvim_list_bufs()) do
    if vim.api.nvim_buf_is_loaded(buf) and vim.bo[buf].buftype == "terminal" then return buf end
  end
  return nil
end

local function SendCellToREPL()
  local cursor = vim.api.nvim_win_get_cursor(0)
  local ft = vim.bo.filetype

  local pattern_vim = '^# %%'
  local pattern_lua = '^# %%'
  if ft == 'typst' then
    pattern_vim = '```'
    pattern_lua = '```'
  elseif ft == 'matlab' then
    pattern_vim = '^%%'
    -- Lua needs %% to match a literal %
    pattern_lua = '^%%%%'
  end

  local start_line = vim.fn.search(pattern_vim, 'bnW')
  start_line = (start_line == 0) and 1 or (start_line + 1)

  local end_line = vim.fn.search(pattern_vim, 'nW')
  end_line = (end_line == 0) and vim.api.nvim_buf_line_count(0) or (end_line - 1)

  if vim.api.nvim_get_current_line():find(pattern_lua) then
    start_line = cursor[1] + 1
    end_line = vim.fn.search(pattern_vim, 'nW')
    end_line = (end_line == 0) and vim.api.nvim_buf_line_count(0) or (end_line - 1)
  end

  if start_line > end_line then return end
  local lines = vim.api.nvim_buf_get_lines(0, start_line - 1, end_line, false)
  table.insert(lines, "")

  local term_buf = get_active_terminal()
  if term_buf then
    _G.last_repl_start_line = vim.api.nvim_buf_line_count(term_buf)
    vim.fn.chansend(vim.bo[term_buf].channel, lines)
    local next_cell = vim.fn.search(pattern_vim, 'W')
    if next_cell > 0 then vim.api.nvim_win_set_cursor(0, { next_cell, 0 }) end
  else
    vim.notify("No active terminal found! Open one with <leader>t first.", vim.log.levels.WARN)
  end
end



vim.keymap.set("n", "<leader>re", SendCellToREPL, { desc = "Evaluate Cell Only", silent = true })
