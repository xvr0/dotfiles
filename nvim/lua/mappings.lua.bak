local function OpenPDFUnderCursor()
    local filepath = vim.fn.expand('<cfile>')
    
    -- Strip any surrounding quotes that <cfile> might accidentally capture
    filepath = filepath:gsub('^["\']+', ''):gsub('["\']+$', '')

    if not filepath:match('%.pdf$') then
        print("Not a PDF. Cursor is on: " .. filepath)
        return
    end

    -- Convert to absolute path to guarantee filereadable finds it
    local full_path = vim.fn.fnamemodify(filepath, ":p")

    if vim.fn.filereadable(full_path) == 1 then
        local job_id = vim.fn.jobstart({ "zathura", full_path }, { detach = true })
        if job_id <= 0 then
            print("Error: Failed to launch zathura. Is it installed and on your PATH?")
        else
            print("Success! Opened: " .. full_path)
        end
    else
        print("File not found on disk: " .. full_path)
    end
end

vim.keymap.set("n", "<leader>pd", OpenPDFUnderCursor, { desc = "Open PDF under cursor" })
-------------------------------
-- TERMINAL & RUNNER LOGIC
-------------------------------
local function toggle_terminal()
  local term_buf = nil
  for _, buf in ipairs(vim.api.nvim_list_bufs()) do
    if vim.api.nvim_buf_is_loaded(buf) and vim.bo[buf].buftype == "terminal" then
      term_buf = buf
      break
    end
  end

  if term_buf then
    local win_found = nil
    for _, win in ipairs(vim.api.nvim_tabpage_list_wins(0)) do
      if vim.api.nvim_win_get_buf(win) == term_buf then
        win_found = win
        break
      end
    end

    if win_found then
      vim.api.nvim_win_close(win_found, false)
    else
      vim.cmd("botright split")
      vim.api.nvim_set_current_buf(term_buf)
      vim.cmd("startinsert")
    end
  else
    vim.cmd("botright split | term")
    vim.cmd("startinsert")
  end
end

vim.keymap.set('n', '<C-t>', toggle_terminal, { noremap = true, silent = true, desc = "Toggle Terminal" })
vim.keymap.set('t', '<C-t>', toggle_terminal, { noremap = true, silent = true, desc = "Toggle Terminal" })
map("n", "<leader>bt", "<cmd>bd!<CR>")

_G.runner_terminals = _G.runner_terminals or {}

local function RunFile()
  vim.cmd('w')
  local filetype = vim.bo.filetype
  local filename = vim.fn.shellescape(vim.fn.expand('%'))
  local full_path = vim.fn.expand('%:p')

  local function send_to_term(win_name, cmd, is_repl, repl_start_cmd)
    local buf = _G.runner_terminals[win_name]

    if buf and not vim.api.nvim_buf_is_valid(buf) then buf = nil end
    if buf and vim.bo[buf].buftype ~= 'terminal' then buf = nil end

    local is_new = false
    if not buf then
      vim.cmd('botright split | term')
      buf = vim.api.nvim_get_current_buf()
      _G.runner_terminals[win_name] = buf
      is_new = true
    else
      local win_found = false
      for _, win in ipairs(vim.api.nvim_list_wins()) do
        if vim.api.nvim_win_get_buf(win) == buf then
          vim.api.nvim_set_current_win(win)
          win_found = true
          break
        end
      end
      if not win_found then
        vim.cmd('botright split')
        vim.api.nvim_set_current_buf(buf)
      end
    end

    vim.cmd('startinsert')
    local chan = vim.bo[buf].channel

    if is_new and is_repl and repl_start_cmd then
      vim.fn.chansend(chan, repl_start_cmd .. "\r")
    else
      vim.fn.chansend(chan, cmd .. "\r")
    end
  end

  if filetype == 'python' then
    send_to_term('runner', 'python3 ' .. filename, false)
  elseif filetype == 'c' then
    local base_name = vim.fn.expand('%:r')
    send_to_term('runner', 'gcc ' .. filename .. ' -o ' .. base_name .. ' -lfftw3 -lm && ./' .. base_name, false)
  elseif filetype == 'sh' or filetype == 'bash' then
    send_to_term('runner', 'bash ' .. filename, false)
  elseif filetype == 'julia' then
    local j_cmd = 'include("' .. full_path .. '")'
    local j_start = 'julia -i "' .. full_path .. '"'
    send_to_term('julia_repl', j_cmd, true, j_start)
  elseif filetype == 'matlab' then
    local m_cmd = "run('" .. full_path .. "')"
    local m_start = 'matlab -nodesktop -nosplash -r "' .. m_cmd .. '"'
    send_to_term('matlab_repl', m_cmd, true, m_start)
  elseif filetype == 'cpp' then
    if vim.fn.filereadable('CMakeLists.txt') == 1 then
      send_to_term('runner',
        'cmake -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build build && echo ---Output--- && \\$(find build -maxdepth 1 -type f -executable | head -n 1)',
        false)
    else
      local base_name = vim.fn.expand('%:r')
      send_to_term('runner',
        'g++ $([ -f compile_flags.txt ] && cat compile_flags.txt ) ' ..
        filename .. ' -o ' .. base_name .. ' && ./' .. base_name, false)
    end
  end
end

vim.keymap.set('n', '<leader>x', RunFile, { desc = 'Run/Execute Current File', silent = true })
map("n", "<leader>ht", "<cmd> terminal htop <CR>")

local function RepeatLastRunnerCmd()
  local buf = _G.runner_terminals['runner']

  if buf and not vim.api.nvim_buf_is_valid(buf) then buf = nil end
  if buf and vim.bo[buf].buftype ~= 'terminal' then buf = nil end

  if not buf then
    vim.notify("No runner terminal exists yet. Run <leader>x first.", vim.log.levels.WARN)
    return
  end

  local win_found = false
  for _, win in ipairs(vim.api.nvim_list_wins()) do
    if vim.api.nvim_win_get_buf(win) == buf then
      vim.api.nvim_set_current_win(win)
      win_found = true
      break
    end
  end

  if not win_found then
    vim.cmd('botright split')
    vim.api.nvim_set_current_buf(buf)
  end

  vim.cmd('startinsert')
  local chan = vim.bo[buf].channel
  vim.fn.chansend(chan, "!!\r\r")
end

vim.keymap.set("n", "<leader>y", RepeatLastRunnerCmd, { desc = "Repeat Last Shell Command", silent = true })
